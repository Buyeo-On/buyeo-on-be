# Local/CI verification must use a non-production DB reachable from the app container.
# Runtime application role (DML only).
DB_URL=jdbc:postgresql://db.example.com:5432/buyeoon
DB_USERNAME=buyeoon_application
DB_PASSWORD=change-me

# Flyway migrator role (DDL). Infrastructure must install PostGIS before Flyway runs.
FLYWAY_URL=jdbc:postgresql://db.example.com:5432/buyeoon
FLYWAY_USERNAME=buyeoon_migrator
FLYWAY_PASSWORD=change-me

# Docker Compose exposes Nginx on this host port.
HTTP_PORT=8080
