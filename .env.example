# Local development uses a non-production Supabase DB reachable from the app container.
# Application database account used for both Flyway DDL and runtime DML.
DB_URL=jdbc:postgresql://db.example.com:5432/buyeoon
DB_USERNAME=buyeoon_app
DB_PASSWORD=change-me

# Docker Compose exposes Nginx on this host port.
HTTP_PORT=8080
