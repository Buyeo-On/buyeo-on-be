# Runtime application role (DML only). Provision the role and grants through infrastructure.
DB_URL=jdbc:postgresql://localhost:5432/buyeoon
DB_USERNAME=buyeoon_application
DB_PASSWORD=change-me

# Flyway migrator role (DDL). Infrastructure must install PostGIS before Flyway runs.
FLYWAY_URL=jdbc:postgresql://localhost:5432/buyeoon
FLYWAY_USERNAME=buyeoon_migrator
FLYWAY_PASSWORD=change-me
